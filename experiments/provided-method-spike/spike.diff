diff --git a/crates/happenstance-core/tests/provided_method_spike.rs b/crates/happenstance-core/tests/provided_method_spike.rs
new file mode 100644
index 0000000..0df9813
--- /dev/null
+++ b/crates/happenstance-core/tests/provided_method_spike.rs
@@ -0,0 +1,198 @@
+//! SPIKE (experiments/provided-method-spike): the provided methods compile for
+//! a `!Send` implementor of the bare flavour, answer their defaults, and are
+//! spawnable from code generic over the `Send` flavour with no `Sync` bound.
+#![allow(clippy::unwrap_used, clippy::expect_used, reason = "spike test code")]
+
+use std::cell::Cell;
+use std::rc::Rc;
+
+use happenstance_core::{
+    AppendCondition, AppendError, Authority, Checkpoint, CommitError, Event, EventId, EventStore,
+    HistoryReport, MemoryEventStore, MemoryProjectionBatch, MemoryProjectionStore,
+    MemoryProjectionStoreError, MemoryStoreError, ProjectionId, ProjectionStore, Query,
+    ReadOptions, ResetError, SequencePosition, SequencedEvent,
+};
+
+// ---------------------------------------------------------------------------
+// !Send, !Sync implementors of the BARE flavours, written exactly as they were
+// before the spike: required methods only. That they compile is use 1 and 2's
+// first half.
+// ---------------------------------------------------------------------------
+
+struct LocalEvents {
+    inner: MemoryEventStore,
+    _not_send: Rc<Cell<u8>>,
+}
+
+impl EventStore for LocalEvents {
+    type Error = MemoryStoreError;
+
+    fn read(
+        &self,
+        query: &Query,
+        options: ReadOptions,
+    ) -> impl futures_core::Stream<Item = Result<SequencedEvent, Self::Error>> {
+        EventStore::read(&self.inner, query, options)
+    }
+
+    async fn append(
+        &self,
+        events: &[Event],
+        condition: Option<&AppendCondition>,
+    ) -> Result<SequencePosition, AppendError<Self::Error>> {
+        EventStore::append(&self.inner, events, condition).await
+    }
+
+    async fn head(&self) -> Result<Option<SequencePosition>, Self::Error> {
+        EventStore::head(&self.inner).await
+    }
+
+    async fn contains_event_id(&self, id: EventId) -> Result<bool, Self::Error> {
+        EventStore::contains_event_id(&self.inner, id).await
+    }
+}
+
+struct LocalProjections {
+    inner: MemoryProjectionStore,
+    _not_send: Rc<Cell<u8>>,
+}
+
+impl ProjectionStore for LocalProjections {
+    type Error = MemoryProjectionStoreError;
+    type Batch = MemoryProjectionBatch;
+
+    async fn begin(&self) -> Result<Self::Batch, Self::Error> {
+        ProjectionStore::begin(&self.inner).await
+    }
+
+    async fn checkpoint(&self, id: &ProjectionId) -> Result<Checkpoint, Self::Error> {
+        ProjectionStore::checkpoint(&self.inner, id).await
+    }
+
+    async fn commit(
+        &self,
+        batch: Self::Batch,
+        id: &ProjectionId,
+        position: SequencePosition,
+        authority: Authority,
+    ) -> Result<(), CommitError<Self::Error>> {
+        ProjectionStore::commit(&self.inner, batch, id, position, authority).await
+    }
+
+    async fn reset(
+        &self,
+        batch: Self::Batch,
+        id: &ProjectionId,
+    ) -> Result<(), ResetError<Self::Error>> {
+        ProjectionStore::reset(&self.inner, batch, id).await
+    }
+
+    async fn rollback(&self, batch: Self::Batch) -> Result<(), Self::Error> {
+        ProjectionStore::rollback(&self.inner, batch).await
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Generic over the BARE flavour: accepts both the !Send store and the Send one.
+// ---------------------------------------------------------------------------
+
+async fn history_of<S: EventStore>(store: &S) -> HistoryReport {
+    store.history().await.ok().unwrap()
+}
+
+async fn commit_all_of<S: ProjectionStore>(store: &S) -> bool {
+    let batch = store.begin().await.ok().unwrap();
+    let id = ProjectionId::new("spike");
+    matches!(
+        store
+            .commit_all(batch, &[(id, SequencePosition::FIRST)], Authority::Live)
+            .await,
+        Err(CommitError::Unsupported)
+    )
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn bare_flavour_defaults_answer_for_a_not_send_store() {
+    let events = LocalEvents {
+        inner: MemoryEventStore::new(),
+        _not_send: Rc::new(Cell::new(0)),
+    };
+    assert_eq!(history_of(&events).await, HistoryReport::Unknown);
+
+    let projections = LocalProjections {
+        inner: MemoryProjectionStore::new(),
+        _not_send: Rc::new(Cell::new(0)),
+    };
+    assert!(commit_all_of(&projections).await);
+    // The refused commit_all dropped its batch; the store is still usable and
+    // no checkpoint moved.
+    assert_eq!(
+        projections
+            .checkpoint(&ProjectionId::new("spike"))
+            .await
+            .ok()
+            .unwrap(),
+        Checkpoint::NeverRun
+    );
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn bare_flavour_defaults_answer_for_a_send_store() {
+    // MemoryEventStore implements SendEventStore; it reaches EventStore
+    // through trait_variant's blanket impl, which forwards to the Send
+    // flavour's copy of the default body.
+    assert_eq!(
+        history_of(&MemoryEventStore::new()).await,
+        HistoryReport::Unknown
+    );
+    assert!(commit_all_of(&MemoryProjectionStore::new()).await);
+}
+
+// ---------------------------------------------------------------------------
+// Generic over the SEND flavour, spawned. Deliberately NO `Sync` bound: the
+// store is moved into the task and borrowed across the await, which is only
+// sound because the default future does not capture `&self`. Compare
+// `memory.rs`'s `Probe::doubled`, whose default does, and needs `Self: Sync`.
+// ---------------------------------------------------------------------------
+
+fn spawn_history<S>(store: S) -> tokio::task::JoinHandle<bool>
+where
+    S: happenstance_core::SendEventStore + 'static,
+{
+    tokio::spawn(async move {
+        let report = happenstance_core::SendEventStore::history(&store).await;
+        // Collapsed before any further await: S::Error carries no Send bound.
+        matches!(report, Ok(HistoryReport::Unknown))
+    })
+}
+
+fn spawn_commit_all<S>(store: S) -> tokio::task::JoinHandle<bool>
+where
+    S: happenstance_core::SendProjectionStore + 'static,
+    S::Batch: Send,
+{
+    tokio::spawn(async move {
+        let Ok(batch) = happenstance_core::SendProjectionStore::begin(&store).await else {
+            return false;
+        };
+        let id = ProjectionId::new("spike");
+        let outcome = happenstance_core::SendProjectionStore::commit_all(
+            &store,
+            batch,
+            &[(id, SequencePosition::FIRST)],
+            Authority::Live,
+        )
+        .await;
+        matches!(outcome, Err(CommitError::Unsupported))
+    })
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn send_flavour_defaults_spawn_from_generic_code_without_sync() {
+    assert!(spawn_history(MemoryEventStore::new()).await.unwrap());
+    assert!(
+        spawn_commit_all(MemoryProjectionStore::new())
+            .await
+            .unwrap()
+    );
+}
