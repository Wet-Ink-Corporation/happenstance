@@ -0,0 +1,82 @@
+//! SPIKE (experiments/provided-method-spike): `Projection::on_error`'s default.
+#![cfg(feature = "unstable-projection")]
+#![allow(clippy::unwrap_used, clippy::expect_used, reason = "spike test code")]
+
+use happenstance::bytes::Bytes;
+use happenstance::{
+    Codec, CodecError, DomainEvent, EventType, MemoryProjectionBatch, MemoryProjectionStore,
+    MemoryProjectionStoreError, OnError, Projection, ProjectionId, SequencePosition, Tags,
+};
+
+const NOTED: EventType = EventType::from_static("Noted");
+
+#[derive(Debug, Clone, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+struct Noted;
+
+impl DomainEvent for Noted {
+    const EVENT_TYPES: &'static [EventType] = &[NOTED];
+    fn event_type(&self) -> EventType {
+        NOTED
+    }
+    fn tags(&self) -> Tags {
+        Tags::default()
+    }
+    fn encode<C: Codec>(&self, codec: &C) -> Result<Bytes, CodecError> {
+        codec.encode(self)
+    }
+    fn decode<C: Codec>(
+        codec: &C,
+        _event_type: &EventType,
+        data: &Bytes,
+    ) -> Result<Self, CodecError> {
+        codec.decode(data)
+    }
+}
+
+/// An implementor written as before the spike: `on_error` is not mentioned.
+struct Nothing {
+    id: ProjectionId,
+    scope: Tags,
+}
+
+impl Projection for Nothing {
+    type Event = Noted;
+    type Store = MemoryProjectionStore;
+    fn id(&self) -> &ProjectionId {
+        &self.id
+    }
+    fn scope(&self) -> &Tags {
+        &self.scope
+    }
+    fn apply(
+        &mut self,
+        _event: Self::Event,
+        _batch: &mut MemoryProjectionBatch,
+    ) -> Result<(), MemoryProjectionStoreError> {
+        Ok(())
+    }
+}
+
+/// Bare-bound generic caller: the default is callable.
+async fn ask<P: Projection>(projection: &mut P) -> OnError {
+    projection.on_error(SequencePosition::FIRST).await
+}
+
+/// Concrete `P`: the default's future is `Send` by auto-trait leakage, so this
+/// spawns. It proves nothing about generic code; `spike_negative` below does.
+fn spawn_concrete(mut projection: Nothing) -> tokio::task::JoinHandle<OnError> {
+    tokio::spawn(async move { projection.on_error(SequencePosition::FIRST).await })
+}
+
+// The generic-`P` spawn is `provided_method_spike_negative.rs`, a file that is
+// expected not to compile; its transcript is in the experiment's results/.
+
+#[tokio::test(flavor = "current_thread")]
+async fn the_default_answers_stop() {
+    let mut projection = Nothing {
+        id: ProjectionId::new("spike"),
+        scope: Tags::default(),
+    };
+    assert_eq!(ask(&mut projection).await, OnError::Stop);
+    assert_eq!(spawn_concrete(projection).await.unwrap(), OnError::Stop);
+}
